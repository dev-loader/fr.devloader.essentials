{
  "name": "fr.devloader.essentials",
  "displayName": "Dev'loader Essentials Library",
  "author": {
    "name": "Dev'loader",
    "url": "https://devloader.fr",
    "email": "contact@devloader.fr"
  },
  "version": "1.0.0-1.9.0",
  "unity": "6000.5",
  "unityRelease": "7f1",
  "description": "Provides basic scripts and some samples.",
  "keywords": [
    "essentials",
    "materials",
    "prefabs",
    "scripts",
    "shaders",
    "trees",
    "water"
  ],
  "samples": [
    {
      "displayName": "Required Assets",
      "description": "Provides the assets needed by the other samples.",
      "path": "Samples~/Core"
    },
    {
      "displayName": "Additional Assets",
      "description": "Provides some shapes, textures and ui assets.\n\nUI assets is containing Material color samples using \"UI/Default\" shaders, an \"Advanced Fade Button\" and a \"Grid Scroll View\" prefabs, and some sprite samples usable as background element.",
      "path": "Samples~/Additional"
    },
    {
      "displayName": "Built-in Materials (deprecated)",
      "description": "Provides some colors using \"Standard\" shaders.",
      "path": "Samples~/Materials/Built-in"
    },
    {
      "displayName": "HDRP Material",
      "description": "Provides some colors using \"HDRP/Lit\" shaders.",
      "path": "Samples~/Materials/HDRP"
    },
    {
      "displayName": "URP Environment Assets",
      "description": "Provides some brushes, trees and water assets.",
      "path": "Samples~/Environment/URP"
    },
    {
      "displayName": "URP Materials",
      "description": "Provides some colors using \"URP/Lit\" shaders.",
      "path": "Samples~/Materials/URP"
    }
  ]
}